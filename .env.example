# Copy to .env.local and fill in. .env.local is gitignored — this repo is public,
# so nothing with a real value belongs in any file that is not.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API Keys (new sb_publishable_ / sb_secret_ format)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Bypasses Row Level Security entirely. Rotate if ever exposed.
# Used by background jobs and the cron sweep. Never import into a Client
# Component, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── Extraction provider (Phase 3) ─────────────────────────────────────────
# "gemini" for the deployed demo, "foundry" for local/bulk work.
EXTRACTION_PROVIDER=gemini

GEMINI_API_KEY=

AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=

# Documents below this confidence go to the review queue instead of active.
# Models cluster their confidences on round numbers (0.85/0.90/0.95), so a
# threshold sitting exactly on one of them decides by tie-break rather than by
# judgement. 0.90 means any expressed doubt reaches a human.
EXTRACTION_CONFIDENCE_THRESHOLD=0.90

# ── Background jobs (Phase 3) ─────────────────────────────────────────────
# Local development only. Points the SDK at the Inngest dev server
# (npx inngest-cli@latest dev) instead of Inngest Cloud. Leave this UNSET in
# production — a deployed app with it set looks for a dev server that is not
# there, and the SDK fails with "in cloud mode but no signing key found" the
# other way round.
INNGEST_DEV=1

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Email (Phase 5) ───────────────────────────────────────────────────────
RESEND_API_KEY=
REMINDER_FROM_EMAIL=

# ── Cron (Phase 5) ────────────────────────────────────────────────────────
# Shared secret checked by /api/cron/sweep before it runs. Set the same value
# in Vercel and in the GitHub Actions backup workflow's secrets.
CRON_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: override the extraction model. Google retires ids and refuses them
# for new projects, so treat the default as a moving target — when the API
# rejects one it names the replacement in the error.
GEMINI_MODEL=

# ── Admin seed (pnpm seed:admin) ──────────────────────────────────────────
# Creates an owner account and an organization for it. Never commit real
# values — this account can delete the organization.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ORG_NAME=

# ── Demo seed (pnpm seed:demo) ────────────────────────────────────────────
# Creates the account the public landing page advertises, plus a fleet whose
# documents land in every dashboard state. Requires the admin seed first: the
# admin OWNS the demo organization and the demo account is only a manager, so
# a visitor cannot delete it.
#
# Re-run it any time to reset the demo data — visitors can edit and delete.
SEED_DEMO_EMAIL=
SEED_DEMO_PASSWORD=
SEED_DEMO_ORG=Luzon Freight Lines

# ── Landing page "Try the demo" button ────────────────────────────────────
# Server-only, and deliberately NOT NEXT_PUBLIC_. The landing page's demo
# action reads these to sign a visitor in without asking them to type
# anything, so the password never reaches a browser or the client bundle.
#
# An earlier version printed the credentials on the page through
# NEXT_PUBLIC_ variables. That published the password to every visitor and
# still made them copy it — worse on both counts.
#
# Point these at the demo account seeded above, never at an owner: whoever
# presses the button gets that account's permissions.
#
# Leave both unset and the button is replaced by a link to the source.
DEMO_EMAIL=
DEMO_PASSWORD=
